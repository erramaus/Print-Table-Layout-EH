{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Verify Optimizer",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "verify:optimizer"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify Optimizer Fixture",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "verify:optimizer",
        "--",
        "--fixture",
        "${input:fixtureName}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify Then Build",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Verify Optimizer",
        "Build"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "fixtureName",
      "type": "promptString",
      "description": "Optimizer fixture name"
    }
  ]
}
